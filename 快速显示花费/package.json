{
  "name": "dsh-plugin-inline-cost",
  "version": "0.9.5",
  "description": "DSH 插件「快速显示花费」：官方「Token 用量」卡片打开时追加一行花费金额；锚定官方 role=dialog 的 dl，会话卡片取 token-mb 官方记录，单轮卡片按本轮数字估算。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "tools",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "author": "zaowanshangxian",
  "homepage": "https://github.com/zaowanshangxian/deepseek-harness-plugins/tree/main/%E5%BF%AB%E9%80%9F%E6%98%BE%E7%A4%BA%E8%8A%B1%E8%B4%B9#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaowanshangxian/deepseek-harness-plugins.git",
    "directory": "快速显示花费"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "smoke": "node tools/smoke.mjs",
    "prepublishOnly": "node tools/build.mjs && node tools/smoke.mjs"
  },
  "bugs": {
    "url": "https://github.com/zaowanshangxian/deepseek-harness-plugins/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "deepseek",
    "token",
    "cost",
    "usage",
    "billing"
  ]
}
